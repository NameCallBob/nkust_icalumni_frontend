{
  "name": "nkust_icalumni",
  "version": "0.1.0",
  "private": false,
  "homepage": "https://nkusticalumni.org/",
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@tippyjs/react": "^4.2.6",
    "axios": "^1.20.0",
    "dompurify": "^3.4.17",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.509.0",
    "moment": "^2.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.5.0",
    "react-photo-album": "^3.1.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.30.6",
    "react-scripts": "5.0.1",
    "react-toastify": "^10.0.6",
    "react-transition-group": "^4.4.5",
    "swiper": "^12.2.0",
    "tippy.js": "^6.3.7",
    "web-vitals": "^2.1.4",
    "yet-another-react-lightbox": "^3.23.0"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "postbuild": "node scripts/prerender.mjs",
    "test": "craco test",
    "eject": "react-scripts eject",
    "test:ci": "craco test --watchAll=false --ci",
    "test:coverage": "craco test --watchAll=false --coverage",
    "lint": "eslint src --ext .js,.jsx --max-warnings=68",
    "e2e": "npm --prefix e2e test",
    "e2e:smoke": "npm --prefix e2e run test:smoke",
    "lint:strict": "eslint src --ext .js,.jsx --max-warnings=0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.24",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.31",
    "prettier": "3.6.2",
    "puppeteer": "^25.16.0",
    "tailwindcss": "^3.4.10"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.js",
      "!src/reportWebVitals.js",
      "!src/setupTests.js",
      "!src/**/*.test.{js,jsx}",
      "!src/assets/**"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "src/utils/seoHelper.js": {
        "statements": 80,
        "branches": 70,
        "functions": 80,
        "lines": 80
      },
      "src/utils/imageDefaults.js": {
        "statements": 80,
        "branches": 70,
        "functions": 80,
        "lines": 80
      },
      "src/hooks/useRWD.js": {
        "statements": 70,
        "branches": 60,
        "functions": 60,
        "lines": 70
      }
    },
    "moduleNameMapper": {
      "^axios$": "axios/dist/node/axios.cjs"
    }
  },
  "overrides": {
    "postcss": "$postcss",
    "serialize-javascript": "^7.1.4",
    "nth-check": "^2.1.1",
    "underscore": "^1.13.8",
    "node-forge": "^1.4.0"
  }
}
